{
  "name": "kinoflow-studio",
  "private": true,
  "version": "1.2.76",
  "description": "KinoFlow Studio desktop and web client for local ComfyUI video generation",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:renderer": "vite build --outDir build-renderer --base ./",
    "electron:start": "electron .",
    "electron:build": "npm run build:renderer && npx electron-builder --win --publish never",
    "preview": "vite preview",
    "clean": "rm -rf dist build-renderer server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test electron/*.test.ts src/services/*.test.ts src/utils/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.kinoflow.studio",
    "productName": "KinoFlowStudio",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "build-renderer/**/*",
      "electron/**/*.js",
      "electron/**/*.cjs",
      "!electron/**/*.test.ts",
      "!electron/**/*.d.ts",
      "!node_modules/**/*",
      "workflow_t2v.json",
      "workflow_i2v.json",
      "package.json",
      "assets/icon.ico"
    ],
    "asarUnpack": [
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KinoFlowStudio",
      "runAfterFinish": true
    }
  }
}
